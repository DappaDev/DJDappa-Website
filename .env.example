# Copy this file to .env.local and fill in both values from
# Supabase → Project Settings → API (or the "Connect" button).
# Use the publishable key (older projects: "anon public"). It is safe to ship in the website; never put the secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
